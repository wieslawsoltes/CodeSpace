   <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0078d4" />
   <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  </ResourceDictionary>
 </Application.Resources>
</Application>
